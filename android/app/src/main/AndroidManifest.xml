<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Il servizio in primo piano e' cio' che tiene viva la riproduzione
         a schermo spento: senza, Android sospende il processo. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <!-- Da Android 14 ogni tipo di servizio in primo piano vuole il suo
         permesso: questo e' per i download, che devono proseguire anche
         se l'utente chiude l'app. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- Da Android 13 la notifica del player va chiesta esplicitamente.
         Se l'utente la nega la musica suona lo stesso, ma senza controlli
         sulla schermata di blocco. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Trasmettere vuol dire trovare gli apparecchi sulla rete locale e
         fare da sorgente per loro: servono lo stato della rete e, da
         Android 13, il permesso per i dispositivi vicini. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <application
        android:name=".SoSoundApp"
        android:allowBackup="true"
        android:fullBackupContent="@xml/copia_vecchia"
        android:dataExtractionRules="@xml/copia"
        android:networkSecurityConfig="@xml/rete"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SoSound">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.SoSound">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".playback.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
                <!-- Fa arrivare qui i tasti degli auricolari Bluetooth
                     anche quando l'app non e' in primo piano. -->
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </service>

        <!-- Il Cast SDK cerca questa classe per nome all'avvio: senza la
             dichiarazione, l'inizializzazione fallisce con un errore che
             non nomina il manifest. -->
        <meta-data
            android:name="com.google.android.gms.cast.framework.OPTIONS_PROVIDER_CLASS_NAME"
            android:value="com.sosound.app.cast.SoSoundCastOptions" />

        <service
            android:name=".data.download.DownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

    </application>
</manifest>
